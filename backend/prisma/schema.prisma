// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENTE
  ADMIN
}

enum ReservationStatus {
  RESERVADA
  RETIRADA
  NO_RETIRADA
  CANCELADA
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CLIENTE)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reservations Reservation[]

  @@map("users")
}

model Restaurant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  address     String   @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  surpluses Surplus[]

  @@map("restaurants")
}

model Surplus {
  id                String   @id @default(uuid()) @db.Uuid
  restaurantId      String   @map("restaurant_id") @db.Uuid
  name              String   @db.VarChar(150)
  imageUrls         String[] @default([]) @map("image_urls")
  foodType          String?  @map("food_type") @db.VarChar(30)
  quantityAvailable Int      @map("quantity_available")
  weightKg          Decimal  @map("weight_kg") @db.Decimal(10, 3)
  originalPrice     Decimal  @map("original_price") @db.Decimal(12, 2)
  rescuePrice       Decimal  @map("rescue_price") @db.Decimal(12, 2)
  date              DateTime @db.Date
  pickupFrom        DateTime @map("pickup_from") @db.Time(0)
  pickupUntil       DateTime @map("pickup_until") @db.Time(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]

  @@map("surpluses")
}

model Reservation {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  surplusId    String            @map("surplus_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal           @map("unit_price") @db.Decimal(12, 2)
  unitWeightKg Decimal           @map("unit_weight_kg") @db.Decimal(10, 3)
  totalAmount  Decimal           @map("total_amount") @db.Decimal(12, 2)
  pickupCode   String            @unique @map("pickup_code") @db.VarChar(20)
  status       ReservationStatus @default(RESERVADA)
  pickedUpAt   DateTime?         @map("picked_up_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id])
  surplus Surplus @relation(fields: [surplusId], references: [id])

  @@map("reservations")
}
